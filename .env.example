# API Configuration
# Base URL for API requests
# Development (with Vite proxy): Use /api-dashboard (proxy handles the routing)
# Production: Use full API URL including path: https://api.yourdomain.com/api-dashboard
VITE_API_BASE_URL=/api-dashboard

# API timeout in milliseconds (optional)
VITE_API_TIMEOUT=30000

# Development proxy target (used in vite.config.ts)
# Only needed for local development
VITE_API_PROXY_TARGET=http://localhost:4000

# Application Environment
# development | production
VITE_APP_ENV=development
